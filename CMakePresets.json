{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_PREFIX_PATH": "$env{QTD_QT_DIR}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "AddressSanitizer (RelWithDebInfo: /RTC1 of Debug excludes ASan)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "QTD_ENABLE_ASAN": "ON" }
        },
        {
            "name": "ubsan",
            "inherits": "base",
            "displayName": "UBSan with clang-cl, core and automation only (E-22)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_COMPILER": "$env{QTD_LLVM_DIR}/clang-cl.exe",
                "CMAKE_LINKER": "$env{QTD_LLVM_DIR}/lld-link.exe",
                "QTD_ENABLE_UBSAN": "ON"
            }
        },
        {
            "name": "coverage",
            "inherits": "base",
            "displayName": "Coverage (unoptimized with PDBs for OpenCppCoverage)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos",
            "displayName": "macOS app bundle (E-46, not yet built)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QTD_QT_DIR}"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "ios",
            "displayName": "iOS app for Xcode (E-46, not yet built)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{QTD_QT_IOS_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
            "cacheVariables": { "QT_HOST_PATH": "$env{QTD_QT_DIR}" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "android",
            "displayName": "Android APK, arm64 (E-46, not yet built)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{QTD_QT_ANDROID_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "QT_HOST_PATH": "$env{QTD_QT_DIR}",
                "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
                "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}"
            }
        },
        {
            "name": "wasm",
            "displayName": "WebAssembly for the browser, single-threaded (E-47)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{QTD_QT_WASM_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "QT_HOST_PATH": "$env{QTD_QT_DIR}"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "ubsan", "configurePreset": "ubsan" },
        { "name": "coverage", "configurePreset": "coverage" },
        { "name": "macos", "configurePreset": "macos" },
        { "name": "ios", "configurePreset": "ios", "configuration": "Release" },
        { "name": "android", "configurePreset": "android", "targets": ["apk"] },
        { "name": "wasm", "configurePreset": "wasm" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "debug", "inherits": "base", "configurePreset": "debug" },
        { "name": "release", "inherits": "base", "configurePreset": "release" },
        {
            "name": "asan",
            "inherits": "base",
            "configurePreset": "asan",
            "filter": { "include": { "label": "core|automation|asan" } }
        },
        { "name": "ubsan", "inherits": "base", "configurePreset": "ubsan" }
    ]
}
